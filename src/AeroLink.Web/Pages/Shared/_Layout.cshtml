<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Elevair</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header class="site-header">
        <div class="header-brand-container">
            <a class="brand" href="/">
                <span class="brand-icon">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.5 1.2c-.2.5 0 1.1.5 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.8 5.3c.3.4.9.6 1.4.3l1.2-.7c.4-.3.6-.9.4-1.4z"/></svg>
                </span>
                <span class="brand-text">Elevair</span>
                <span class="brand-sub">For AeroLink Ground Services</span>
            </a>
        </div>
        
        <nav class="site-nav">
            <a href="/">Home</a>
            <a href="/Manifest">Manifest</a>
            <a href="/BagVerification/Verify">Verify Bag</a>
            <a href="/Exceptions/Report">Report Problem</a>
            <a href="/SupervisorReview">Supervisor Review</a>
        </nav>

        <div class="header-user-actions">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="user-pill">
                    <span class="user-avatar">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                    </span>
                    <span class="user-name">@User.Identity.Name</span>
                    @{
                        var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
                        var isSupervisor = role == "BG_Supervisor";
                    }
                    <span class="badge @(isSupervisor ? "badge-supervisor" : "badge-handler")">
                        @(isSupervisor ? "Supervisor" : "Handler")
                    </span>
                    <a href="/Logout" class="btn-logout" title="Sign out of Elevair">Sign Out</a>
                </div>
            }
            else
            {
                <a href="/Login" class="btn-login-nav">Sign In</a>
            }
        </div>
    </header>

    <main class="container">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="footer-inner">
            <span>Elevair for AeroLink Ground Services &middot; Baggage Unloading, Transfer and Loading Management Prototype</span>
            <span class="footer-meta">Station: BNE &middot; IAB251 Module 5.2</span>
        </div>
    </footer>
</body>
</html>
