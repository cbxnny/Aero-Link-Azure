@page
@model AeroLink.Web.Pages.BagVerification.VerifyModel
@{
    ViewData["Title"] = "Verify Bag";
}

@if (Model.Flights.Any(f => f.FlightId == Model.FlightId && f.LoadingStatus == "Completed"))
{
    <partial name="_ClosedBanner" />
}

<div class="card">
    <h1>Verify Bag Tag</h1>
    <p>Enter a bag tag to check it against the selected flight's manifest before confirming loading.</p>

    @if (!ModelState.IsValid)
    {
        <div class="alert-error">
            @foreach (var error in ModelState.Values.SelectMany(v => v.Errors))
            {
                <div>@error.ErrorMessage</div>
            }
        </div>
    }

    <form method="post">
        <label for="FlightId">Departure flight</label>
        <select id="FlightId" name="FlightId" asp-for="FlightId">
            <option value="">-- select a flight --</option>
            @foreach (var flight in Model.Flights)
            {
                <option value="@flight.FlightId" selected="@(flight.FlightId == Model.FlightId)">
                    @flight.FlightLabel &middot; @flight.FlightNumber &middot; @flight.DepartureAirport &rarr; @flight.ArrivalAirport
                </option>
            }
        </select>

        <label for="Tag">Bag tag</label>
        <input type="text" id="Tag" name="Tag" asp-for="Tag" placeholder="e.g. DEMO-101-001" autocomplete="off" />

        <button class="btn" type="submit" asp-page-handler="Verify">Verify</button>
    </form>
</div>

@if (Model.Result is not null)
{
    var cssClass = Model.Result.Outcome == AeroLink.Web.Models.BagVerificationOutcome.Verified
        ? "alert-success"
        : "alert-error";

    <div class="@cssClass">
        @Model.Result.Message
    </div>

    @if (Model.Result.Bag is not null)
    {
        <div class="card">
            <table>
                <tbody>
                    <tr><th>Tag</th><td>@Model.Result.Bag.Tag</td></tr>
                    <tr><th>Handling type</th><td>@Model.Result.Bag.HandlingType</td></tr>
                    <tr><th>Handling instruction</th><td>@Model.Result.Bag.HandlingInstruction</td></tr>
                    <tr>
                        <th>Status</th>
                        <td>
                            @if (Model.Result.Bag.IsLoaded)
                            {
                                <span class="badge badge-loaded">Loaded</span>
                            }
                            else
                            {
                                <span class="badge badge-pending">@Model.Result.Bag.Outcome</span>
                            }
                        </td>
                    </tr>
                </tbody>
            </table>

            @if (!Model.Result.Bag.IsLoaded &&
                (Model.Result.CanConfirmLoad || Model.Result.Outcome == BagVerificationOutcome.NeedsHandlingAcknowledgement))
            {
                <form method="post" asp-page-handler="Confirm" id="loading-confirmation">
                    <h2>Confirm loading for @Model.Result.Bag.Tag</h2>
                    <input type="hidden" name="FlightId" value="@Model.Result.Bag.FlightId" />
                    <input type="hidden" name="Tag" value="@Model.Result.Bag.Tag" />

                    @if (Model.Result.Outcome == BagVerificationOutcome.NeedsHandlingAcknowledgement)
                    {
                        <p>Acknowledge the handling instructions above before confirming this bag as loaded.</p>
                        <div class="form-row-checkbox">
                            <label class="checkbox-label" for="HandlingAcknowledged">
                                <input type="checkbox" id="HandlingAcknowledged" name="HandlingAcknowledged" value="true" required />
                                I acknowledge the handling instructions for bag @Model.Result.Bag.Tag.
                            </label>
                        </div>
                    }

                    <button class="btn btn-primary" type="submit" id="confirm-loaded">Confirm loaded</button>
                </form>
            }
        </div>
    }
}

<script>
    const confirmationForm = document.getElementById('loading-confirmation');
    if (confirmationForm) {
        const acknowledgement = document.getElementById('HandlingAcknowledged');
        const confirmButton = document.getElementById('confirm-loaded');
        if (acknowledgement) {
            confirmButton.disabled = !acknowledgement.checked;
            acknowledgement.addEventListener('change', () => {
                confirmButton.disabled = !acknowledgement.checked;
            });
        }

        // Changing the selected bag requires verification and fresh acknowledgement.
        for (const fieldId of ['FlightId', 'Tag']) {
            document.getElementById(fieldId).addEventListener('input', () => {
                confirmationForm.hidden = true;
                confirmButton.disabled = true;
                if (acknowledgement) acknowledgement.checked = false;
            });
        }
    }
</script>
