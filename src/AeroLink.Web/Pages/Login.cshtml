@page
@model AeroLink.Web.Pages.LoginModel
@{
    ViewData["Title"] = "Staff Login";
}

<div class="login-wrapper">
    <div class="login-card">
        <div class="login-header">
            <div class="login-badge-icon">✈</div>
            <h2>Elevair</h2>
            <p class="subtitle">AeroLink Ground Services &middot; Airport Baggage Operations Portal &middot; HR Authentication</p>
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert-error" role="alert">
                <strong>Authentication Failed:</strong> @Model.ErrorMessage
            </div>
        }

        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="alert-success">
                <p><strong>Currently signed in as:</strong> @User.Identity.Name</p>
                <div style="margin-top: 0.5rem; display: flex; gap: 0.5rem;">
                    <a href="/" class="btn btn-primary">Go to Operations Dashboard</a>
                    <a href="/Logout" class="btn btn-secondary">Log Out</a>
                </div>
            </div>
        }
        else
        {
            <p>Sign in using the Employee ID and email address registered in the HR system.</p>
            @if (!ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="All" class="alert-error" role="alert"></div>
            }
            <form method="post" class="login-form">
                <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />

                <div class="form-group">
                    <label for="EmployeeId">Employee ID</label>
                    <input type="text"
                           id="EmployeeId"
                           name="EmployeeId"
                           value="@Model.EmployeeId"
                           placeholder="e.g. 100101"
                           inputmode="numeric"
                           pattern="[0-9]+"
                           autocomplete="username"
                           required
                           autofocus />
                </div>

                <div class="form-group">
                    <label for="Email">Employee email</label>
                    <input type="email"
                           id="Email"
                           name="Email"
                           value="@Model.Email"
                           placeholder="e.g. s.mitchell@company.com"
                           autocomplete="email"
                           required />
                </div>

                <div class="form-row-checkbox">
                    <label class="checkbox-label">
                        <input asp-for="RememberMe" />
                        Keep me signed in on this station
                    </label>
                </div>

                <button type="submit" class="btn btn-primary btn-block">Sign In to Elevair</button>
            </form>

        }

        <div class="login-footer-notice">
            <small>Restricted to authorized ground handling and airline station personnel. All verification scans and supervisor decisions are logged for audit compliance.</small>
        </div>
    </div>
</div>