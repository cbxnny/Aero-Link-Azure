@page
@model AeroLink.Web.Pages.LoginModel
@{
    ViewData["Title"] = "Staff Login";
}

<div class="login-wrapper">
    <div class="login-card">
        <div class="login-header">
            <div class="login-badge-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.5 1.2c-.2.5 0 1.1.5 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.8 5.3c.3.4.9.6 1.4.3l1.2-.7c.4-.3.6-.9.4-1.4z"/></svg>
            </div>
            <h2>AeroLink Ground Services</h2>
            <p class="subtitle">Airport Baggage Operations Portal &middot; HR Authentication</p>
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert-error" role="alert">
                <strong>Authentication Failed:</strong> @Model.ErrorMessage
            </div>
        }

        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="alert-success">
                <p><strong>Currently signed in as:</strong> @User.Identity.Name</p>
                <div style="margin-top: 0.5rem; display: flex; gap: 0.5rem;">
                    <a href="/" class="btn btn-primary">Go to Operations Dashboard</a>
                    <a href="/Logout" class="btn btn-secondary">Log Out</a>
                </div>
            </div>
        }
        else
        {
            <form method="post" class="login-form">
                <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />

                <div class="form-group">
                    <label for="Username">Staff ID or Username</label>
                    <input type="text"
                           id="Username"
                           name="Username"
                           value="@Model.Username"
                           placeholder="e.g. supervisor or EMP-1001"
                           autocomplete="username"
                           required
                           autofocus />
                </div>

                <div class="form-group">
                    <label for="Password">Password</label>
                    <input type="password"
                           id="Password"
                           name="Password"
                           placeholder="Enter your security password"
                           autocomplete="current-password"
                           required />
                </div>

                <div class="form-row-checkbox">
                    <label class="checkbox-label">
                        <input type="checkbox" name="RememberMe" value="true" @(Model.RememberMe ? "checked" : "") />
                        Keep me signed in on this station
                    </label>
                </div>

                <button type="submit" class="btn btn-primary btn-block">Sign In to AeroLink</button>
            </form>

            <div class="demo-divider">
                <span>OR FAST-TRACK DEMO ACCESS</span>
            </div>

            <div class="demo-accounts-panel">
                <p class="demo-hint">One-click test sign in (configured against mock HR System API):</p>
                
                <div class="demo-buttons-grid">
                    <form method="post" asp-page-handler="QuickLogin">
                        <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
                        <input type="hidden" name="employeeId" value="EMP-1001" />
                        <button type="submit" class="demo-chip supervisor-chip">
                            <span class="chip-icon">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                            </span>
                            <div class="chip-text">
                                <strong>Sarah Chen</strong>
                                <small>Baggage Supervisor (EMP-1001)</small>
                            </div>
                        </button>
                    </form>

                    <form method="post" asp-page-handler="QuickLogin">
                        <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
                        <input type="hidden" name="employeeId" value="EMP-2001" />
                        <button type="submit" class="demo-chip handler-chip">
                            <span class="chip-icon">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 20h12a2 2 0 0 0 2-2V8H4v10a2 2 0 0 0 2 2z"/><path d="M6 8V6a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v2"/><line x1="12" y1="11" x2="12" y2="15"/><line x1="10" y1="13" x2="14" y2="13"/></svg>
                            </span>
                            <div class="chip-text">
                                <strong>David Miller</strong>
                                <small>Baggage Handler (EMP-2001)</small>
                            </div>
                        </button>
                    </form>

                    <form method="post" asp-page-handler="QuickLogin">
                        <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
                        <input type="hidden" name="employeeId" value="EMP-3001" />
                        <button type="submit" class="demo-chip lead-chip">
                            <span class="chip-icon">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
                            </span>
                            <div class="chip-text">
                                <strong>Alex Taylor</strong>
                                <small>Ground Operations Lead (EMP-3001)</small>
                            </div>
                        </button>
                    </form>
                </div>

                <div class="demo-cred-note">
                    Default password for manual entry: <code>password123</code>
                </div>
            </div>
        }

        <div class="login-footer-notice">
            <small>Restricted to authorized ground handling and airline station personnel. All verification scans and supervisor decisions are logged for audit compliance.</small>
        </div>
    </div>
</div>