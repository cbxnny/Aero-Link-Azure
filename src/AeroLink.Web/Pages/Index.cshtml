@page
@model AeroLink.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Operations Home";
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var userName = User.Identity?.Name ?? "Guest";
    var roleClaim = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
    var roleDisplayName = User.FindFirst("RoleDisplayName")?.Value ?? (isAuthenticated ? "Staff Member" : "Guest Operator");
    var employeeId = User.FindFirst("EmployeeId")?.Value ?? "";
}

<div class="portal-dashboard">
    <!-- Hero / Welcome Banner -->
    <div class="hero-card">
        <div class="hero-content">
            <div class="hero-meta">
            </div>
            <h1>Elevair</h1>
            <p class="hero-subtitle">For AeroLink Ground Services &middot; Departure Baggage Loading Verification & Exception Management System</p>
            
            <div class="user-greeting-banner">
                @if (isAuthenticated)
                {
                    <div class="logged-in-profile-chip">
                        <span class="status-indicator online"></span>
                        <span>Logged in as <strong>@userName</strong></span>
                        <span class="badge @(roleClaim == "BG_Supervisor" ? "badge-supervisor" : "badge-handler")">@roleDisplayName</span>
                        @if (!string.IsNullOrEmpty(employeeId))
                        {
                            <span class="emp-code">[@employeeId]</span>
                        }
                    </div>
                }
                else
                {
                    <div class="guest-banner">
                        <span class="status-indicator guest"></span>
                        <span>Browsing in <strong>Guest Mode</strong>. Sign in with your employee details to access operational functions.</span>
                        <a href="/Login" class="btn btn-sm btn-accent">Sign In</a>
                    </div>
                }
            </div>
        </div>
    </div>

    @if (isAuthenticated)
    {
    <!-- Live Operational Stats Metrics -->
    <div class="metrics-grid">
        <div class="metric-card">
            <div class="metric-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.5 1.2c-.2.5 0 1.1.5 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.8 5.3c.3.4.9.6 1.4.3l1.2-.7c.4-.3.6-.9.4-1.4z"/></svg>
            </div>
            <div class="metric-info">
                <span class="metric-value">@Model.TotalFlights</span>
                <span class="metric-label">Departure Flights</span>
            </div>
        </div>

        <div class="metric-card">
            <div class="metric-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 20h12a2 2 0 0 0 2-2V8H4v10a2 2 0 0 0 2 2z"/><path d="M6 8V6a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v2"/><line x1="12" y1="11" x2="12" y2="15"/><line x1="10" y1="13" x2="14" y2="13"/></svg>
            </div>
            <div class="metric-info">
                <span class="metric-value">@Model.TotalBags</span>
                <span class="metric-label">Tracked Manifest Bags</span>
            </div>
        </div>

        <div class="metric-card">
            <div class="metric-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            </div>
            <div class="metric-info">
                <span class="metric-value">@Model.LoadedBags / @Model.TotalBags</span>
                <span class="metric-label">Bags Loaded (@Model.LoadPercentage%)</span>
            </div>
            <div class="progress-bar-container">
                <div class="progress-bar-fill" style="width: @Model.LoadPercentage%;"></div>
            </div>
        </div>

        <div class="metric-card @(Model.OpenExceptions > 0 ? "metric-alert" : "")">
            <div class="metric-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
            </div>
            <div class="metric-info">
                <span class="metric-value">@Model.OpenExceptions</span>
                <span class="metric-label">Open Exceptions Awaiting Review</span>
            </div>
            @if (Model.OpenExceptions > 0)
            {
                <span class="urgent-tag">Action Required</span>
            }
        </div>
    </div>
    
    <!-- Core Operational Modules Grid -->
    <h2 class="section-title">Operational Workflow Modules</h2>
    <div class="modules-grid">
        <!-- Module I1 -->
        <div class="module-card">
            <div class="module-header">
                <span class="module-badge">STORY I1</span>
                <span class="module-role-pill">Handler & Supervisor</span>
            </div>
            <h3>Flight Baggage Manifest</h3>
            <p>Inspect real-time loading manifests for active departures, view assigned bags, handling flags, and remaining cargo.</p>
            <div class="module-action">
                <a href="/Manifest" class="btn btn-primary btn-block">Open Manifest &rarr;</a>
            </div>
        </div>

        <!-- Module I2 -->
        <div class="module-card">
            <div class="module-header">
                <span class="module-badge">STORY I2</span>
                <span class="module-role-pill">Ramp Handler</span>
            </div>
            <h3>Baggage Verification</h3>
            <p>Scan and confirm bag tags at the aircraft belt. Enforces manifest membership, destination checks, and flags special cargo.</p>
            <div class="module-action">
                <a href="/BagVerification/Verify" class="btn btn-primary btn-block">Verify Bag Tag &rarr;</a>
            </div>
        </div>

        <!-- Module I4 -->
        <div class="module-card">
            <div class="module-header">
                <span class="module-badge">STORY I4</span>
                <span class="module-role-pill">Ramp Handler</span>
            </div>
            <h3>Report Bag Problem</h3>
            <p>Log damaged, missing, or unreadable baggage tags. Immediately isolates baggage from aircraft hold until investigated.</p>
            <div class="module-action">
                <a href="/Exceptions/Report" class="btn btn-warning btn-block">Report Exception &rarr;</a>
            </div>
        </div>

        <!-- Module I5 -->
        <div class="module-card @(Model.OpenExceptions > 0 ? "highlight-card" : "")">
            <div class="module-header">
                <span class="module-badge">STORY I5</span>
                <span class="module-role-pill supervisor-pill">Supervisor Only</span>
            </div>
            <h3>Supervisor Exception Review</h3>
            <p>Review open incident reports, assess ramp issues, and authorize clearance or confirm bags not-to-load.</p>
            <div class="module-action">
                <a href="/SupervisorReview" class="btn btn-primary btn-block">
                    Review Exceptions
                    @if (Model.OpenExceptions > 0)
                    {
                        <span class="badge badge-alert-count">@Model.OpenExceptions</span>
                    }
                    &rarr;
                </a>
            </div>
        </div>
    </div>

<!-- Active Flights Schedule Table -->
    <div class="card schedule-card">
        <div class="card-header-flex">
            <h2>Today's Departure Schedule (BNE)</h2>
            <a href="/Manifest" class="btn btn-sm btn-secondary">View All Manifests</a>
        </div>
        
        <table class="flights-table">
            <thead>
                <tr>
                    <th>Flight</th>
                    <th>Destination</th>
                    <th>Departure (UTC)</th>
                    <th>Aircraft</th>
                    <th>Loading Status</th>
                    <th>Bags Loaded</th>
                    <th>Quick Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var f in Model.Flights)
                {
                    <tr>
                        <td><strong>@f.FlightNumber</strong></td>
                        <td><span class="airport-pill">@f.Destination</span></td>
                        <td>@f.ScheduledDepartureUtc.ToString("HH:mm")</td>
                        <td><code>@f.AircraftId</code></td>
                        <td>
                            <span class="badge @(f.Status == "Completed" ? "badge-loaded" : "badge-pending")">
                                @f.Status
                            </span>
                        </td>
                        <td>
                            <strong>@f.LoadedBags</strong> / @f.TotalBags
                            <span class="subtext">(@(f.TotalBags > 0 ? (int)(100.0 * f.LoadedBags / f.TotalBags) : 0)%)</span>
                        </td>
                        <td class="action-cell">
                            <a href="/Manifest?FlightId=@f.FlightId" class="table-link">Manifest</a>
                            <span class="sep">&middot;</span>
                            <a href="/BagVerification/Verify?FlightId=@f.FlightId" class="table-link">Verify</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    }
    else
    {
        <div class="card">
            <h2>Operational modules</h2>
            <p>Sign in to access your available modules and operational information.</p>
            <ul>
                <li>Turnaround Planning and Resource Allocation</li>
                <li>Baggage Unloading, Transfer and Loading Management</li>
                <li>Departure Readiness and Turnaround Completion</li>
            </ul>
            <a href="/Login" class="btn btn-primary">Sign In</a>
        </div>
    }
</div>
